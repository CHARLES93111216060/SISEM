# SISEM Project - Environment Variables Template
# Copy this file to .env and fill in with your values
# IMPORTANT: Never commit .env to version control!

# ==============================================
# SECURITY CONFIGURATION
# ==============================================

# Flask secret key for session encryption
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=1234567890'0987654321

# Flask debug mode (NEVER True in production)
FLASK_DEBUG=True

# ==============================================
# AUTHENTICATION (TEMPORARY - Replace with DB)
# ==============================================

# Default credentials (TODO: Move to database)
DEFAULT_USER=admin
DEFAULT_PASSWORD=1234567890

# ==============================================
# DATABASE CONFIGURATION (FUTURE)
# ==============================================

# Uncomment and configure when database is implemented
# DATABASE_URL=sqlite:///sisem.db
# DB_USER=sisem_user
# DB_PASSWORD=secure_password

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================

# Application port
FLASK_PORT=5000

# Session timeout (minutes)
SESSION_TIMEOUT=15

# ==============================================
# LOGGING CONFIGURATION
# ==============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==============================================
# FILE MANAGEMENT
# ==============================================

# Maximum file upload size (in MB)
MAX_FILE_SIZE=50

# Informes storage directory
INFORMES_DIR=informes
