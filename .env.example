# Copia este archivo a ".env" y complétalo. NUNCA subas ".env" a un repositorio.

# --- Seguridad ---------------------------------------------------------------------------
# Genera una clave: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Modo desarrollo: true solo en tu computador. En producción false.
FLASK_DEBUG=false
# Minutos de inactividad antes de cerrar la sesión
SESSION_TIMEOUT=15

# --- Usuario administrador -----------------------------------------------------------------
ADMIN_USER=
# Genera el hash con: python tools/generar_hash.py
ADMIN_PASSWORD_HASH=

# --- Base de datos PostgreSQL --------------------------------------------------------------
# En Render usa la "Internal Database URL" del servicio web; en tu computador, la
# "External Database URL" terminada en ?sslmode=require
DATABASE_URL=
# Alternativa a DATABASE_URL (solo si no la defines):
# db_host=localhost
# db_port=5432
# db_user=
# db_password=
# db_name=

# --- Servidor ------------------------------------------------------------------------------
FLASK_PORT=5000
LOG_LEVEL=INFO
# En Render (detrás de proxy) pon 1; en tu computador déjalo en 0
TRUST_PROXY=0
